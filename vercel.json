{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.sovereign-kapitix.net" }],
      "destination": "https://sovereign-kapitix.net/$1",
      "permanent": true
    },
    { "source": "/How-It-Works", "destination": "/how-it-works", "permanent": true },
    { "source": "/review", "destination": "/sovereign-kapitix-review", "permanent": true },
    { "source": "/why-invest", "destination": "/", "permanent": true },
    { "source": "/app", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/disclosure", "destination": "/disclosure/index.html" },
    { "source": "/thank-you", "destination": "/thank-you/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/how-it-works", "destination": "/how-it-works/index.html" },
    { "source": "/sovereign-kapitix-review", "destination": "/sovereign-kapitix-review/index.html" },
    { "source": "/register", "destination": "/register/index.html" }
  ]
}
